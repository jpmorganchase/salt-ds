{
  "name": "@salt-ds/root",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "license": "MIT",
  "repository": "https://github.com/jpmorganchase/salt-ds",
  "workspaces": [
    "packages/**",
    "tooling/**",
    "docs",
    "site"
  ],
  "scripts": {
    "start": "yarn storybook",
    "build": "yarn workspace @salt-ds/knowledge build && yarn workspaces foreach --exclude @salt-ds/site --exclude @salt-ds/knowledge -Apt run build && yarn bundle:css",
    "release": "yarn verify:salt-ai-release-embargo && yarn build && yarn release:verify:after-build && yarn changeset publish",
    "release:verify:after-build": "yarn check:core-react-types && yarn check:date-adapters:pack && yarn release:verify:mcp:after-build",
    "release:verify:mcp": "yarn workspace @salt-ds/mcp build && yarn release:verify:mcp:after-build",
    "release:verify:mcp:after-build": "yarn typecheck && yarn typecheck:ai-tooling && yarn test:ai-tooling && yarn workspace @salt-ds/mcp measure:runtime-loc && yarn workspace @salt-ds/mcp measure:surface && yarn build:ai-tooling && yarn check:ai-tooling:pack -- --profile extraction-parity --report dist/salt-ai-pack/unit-02.json && yarn smoke:consumer --skip-build --pack-report dist/salt-ai-pack/unit-02.json",
    "build:ai-tooling": "yarn workspace @salt-ds/knowledge build && yarn workspace @salt-ds/mcp build",
    "build:ag-grid-theme": "yarn workspace @salt-ds/ag-grid-theme build",
    "build:highcharts-theme": "yarn workspace @salt-ds/highcharts-theme build",
    "bundle:css": "node ./scripts/bundleCss.mjs",
    "bundle:core:css": "yarn workspace @salt-ds/core bundle:css",
    "bundle:date-components:css": "yarn workspace @salt-ds/date-components bundle:css",
    "bundle:lab:css": "yarn workspace @salt-ds/lab bundle:css",
    "bundle:embla-carousel:css": "yarn workspace @salt-ds/embla-carousel bundle:css",
    "copy:icon:css": "yarn workspace @salt-ds/icons copy:css",
    "copy:countries:css": "yarn workspace @salt-ds/countries copy:css",
    "test": "vitest",
    "test:components": "vitest run --config vitest.browser.config.mts --browser.headless",
    "test:components:local": "vitest --config vitest.browser.config.mts",
    "test:ai-tooling": "vitest run packages/knowledge/src packages/mcp/src --maxWorkers=4 && yarn test:salt-ai-governance",
    "test:salt-ai-governance": "node ./scripts/validateSaltAiTracker.mjs && node ./scripts/verifySaltAiReleaseEmbargo.mjs && node ./scripts/verifySaltAiPackageNamespaces.mjs --mode preflight --fixture scripts/fixtures/salt-ai-package-namespaces/preflight.json --now 2026-08-27T00:00:00.000Z --output dist/salt-ai-baseline/package-namespace-fixture-receipt.json && node ./scripts/verifySaltAiPackageNamespaces.mjs --mode preflight --fixture scripts/fixtures/salt-ai-package-namespaces/incompatible.json --expect-failure --now 2026-08-27T00:00:00.000Z --output dist/salt-ai-baseline/package-namespace-hostile-receipt.json && node ./scripts/sealSaltOrdinaryBaseline.mjs --inventory tooling/ai/ordinary-legacy-attestations-v1.json --output dist/salt-ai-baseline/ordinary-baseline-fixture-receipt.json && node ./scripts/validateSaltAiGovernanceReceipts.mjs",
    "verify:salt-ai-release-embargo": "node ./scripts/verifySaltAiReleaseEmbargo.mjs",
    "verify:salt-ai:package-namespaces": "node ./scripts/verifySaltAiPackageNamespaces.mjs",
    "validate:salt-ai:tracker": "node ./scripts/validateSaltAiTracker.mjs",
    "validate:salt-ai:contracts": "node ./scripts/validateSaltAiContracts.mjs",
    "retire:salt-ai:premerge-evidence": "node ./scripts/retireSaltAiPremergeEvidence.mjs",
    "eval:salt-ai:validate": "node ./evals/salt-ai/scripts/validate.mjs",
    "eval:salt-ai:baseline": "node ./evals/salt-ai/scripts/runBaseline.mjs",
    "eval:salt-ai:report": "node ./evals/salt-ai/scripts/buildReport.mjs",
    "validate:salt-ai:governance-receipts": "node ./scripts/validateSaltAiGovernanceReceipts.mjs",
    "seal:salt-ordinary-baseline": "node ./scripts/sealSaltOrdinaryBaseline.mjs",
    "check:ai-tooling:pack": "node ./scripts/checkAiToolingPackageDryRun.mjs",
    "check:date-adapters:pack": "node ./scripts/checkDateAdaptersPackageDryRun.mjs",
    "check:core-react-types": "node ./scripts/checkCoreReactTypeCompatibility.mjs",
    "prettier": "prettier --check .",
    "prettier:ci": "prettier --check .",
    "format": "prettier --write .",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "lint:check:error": "biome check --diagnostic-level=error",
    "lint:style": "yarn lint:style:core && yarn lint:style:icon && yarn lint:style:lab && yarn lint:style:date-components && yarn lint:style:embla-carousel && yarn lint:style:ag-theme && yarn lint:style:highcharts-theme && yarn lint:style:theme",
    "lint:style:core": "yarn stylelint -f verbose \"packages/core/src/**/*.css\"",
    "lint:style:date-components": "yarn stylelint -f verbose \"packages/date-components/src/**/*.css\"",
    "lint:style:icon": "yarn stylelint -f verbose \"packages/icons/src/**/*.css\"",
    "lint:style:lab": "yarn stylelint -f verbose \"packages/lab/src/**/*.css\"",
    "lint:style:embla-carousel": "yarn stylelint -f verbose \"packages/embla-carousel/src/**/*.css\"",
    "lint:style:ag-theme": "yarn stylelint -f verbose \"packages/ag-grid-theme/css/**/*.css\"",
    "lint:style:highcharts-theme": "yarn stylelint -f verbose \"packages/highcharts-theme/src/**/*.css\"",
    "lint:style:theme": "yarn stylelint -f verbose \"packages/theme/css/**/*.css\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "yarn build:ag-grid-theme && yarn bundle:css && storybook build --stats-json",
    "smoke:consumer": "node ./scripts/consumerRepoSmoke.mjs",
    "smoke:consumer:network": "node ./scripts/consumerRepoSmoke.mjs",
    "smoke:consumer:published": "node ./scripts/consumerRepoSmoke.mjs --published",
    "examples:manifest": "node ./scripts/checkPublicExamples.mjs --write-manifest",
    "check:public-examples": "node ./scripts/checkPublicExamples.mjs",
    "check:public-docs": "node ./scripts/checkPublicDocumentation.mjs && yarn check:public-examples",
    "check:sample-apps": "node ./scripts/checkSampleApps.mjs",
    "typecheck": "tsgo --noEmit",
    "typecheck:ai-tooling": "tsc -p packages/knowledge/tsconfig.test.json --noEmit && tsc -p packages/mcp/tsconfig.test.json --noEmit",
    "chromatic": "chromatic"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.10",
    "@biomejs/js-api": "^6.0.0",
    "@biomejs/wasm-nodejs": "^2.5.7",
    "@changesets/cli": "^3.0.0",
    "@e965/xlsx": "^0.20.3",
    "@faker-js/faker": "^8.0.0",
    "@fontsource/open-sans": "^5.0.0",
    "@fontsource/pt-mono": "^5.0.12",
    "@msw/data": "^1.0.0",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-docs": "10.5.3",
    "@storybook/addon-links": "10.5.3",
    "@storybook/icons": "^2.0.1",
    "@storybook/react-vite": "10.5.3",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/dom": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.22",
    "@types/react-color": "^3.0.6",
    "@types/react-dom": "^18.3.7",
    "@types/tinycolor2": "^1.4.3",
    "@typescript/native-preview": "7.0.0-dev.20260601.1",
    "@vitejs/plugin-react": "^6.0.4",
    "ag-grid-community": "^36.0.0",
    "ag-grid-enterprise": "^36.0.0",
    "ag-grid-react": "^36.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.12.1",
    "chromatic": "^18.0.0",
    "ci-info": "^4.0.0",
    "clsx": "^2.0.0",
    "deepmerge": "^4.2.2",
    "dom-accessibility-api": "^0.7.1",
    "highcharts": "10.3.3",
    "highcharts-react-official": "^3.2.2",
    "mockdate": "^3.0.5",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^5.1.0",
    "react-resizable-panels": "^3.0.0",
    "react-router": "^7.10.1",
    "storybook": "10.5.3",
    "stylelint": "^17.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "yup": "^1.7.1"
  },
  "resolutions": {
    "@changesets/assemble-release-plan@npm:^7.0.0": "patch:@changesets/assemble-release-plan@npm%3A7.0.0#~/.yarn/patches/@changesets-assemble-release-plan-npm-7.0.0-3a8fdadcb3.patch",
    "@floating-ui/react": "^0.27.19",
    "cookie": "^1.0.0",
    "esbuild": "^0.28.0",
    "react-markdown": "^10.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-error-boundary": "^6.0.0",
    "tslib": "^2.0.0",
    "path-to-regexp": "^8.4.0",
    "postcss": "^8.5.24"
  },
  "browserslist": {
    "production": [
      "chrome >= 86",
      "firefox >= 86",
      "edge >= 85",
      "iOS >= 15.4",
      "safari >= 15.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "yarn@4.17.0",
  "msw": {
    "workerDirectory": "docs/public"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.4.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "browserslist-to-esbuild": "^2.1.1",
    "execa": "^10.0.0",
    "fs-extra": "^11.0.0",
    "get-tsconfig": "^4.7.5",
    "playwright": "1.62.1",
    "react-dom-types-18-fixture": "npm:@types/react-dom@18.3.7",
    "react-dom-types-floor-fixture": "npm:@types/react-dom@18.3.0",
    "react-types-18-fixture": "npm:@types/react@18.3.31",
    "react-types-floor-fixture": "npm:@types/react@18.3.0",
    "rollup": "^4.24.2",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-postcss": "^4.0.2",
    "vitest-browser-react": "2.2.0"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "msw": {
      "built": true
    },
    "sharp": {
      "built": true
    }
  }
}
