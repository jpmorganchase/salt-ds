{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext", "WebWorker"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "jsx": "react-jsx",
    "paths": {
      "~browser-test-utils/*": ["./test/browser/*"],
      "~storybook-decorators/*": ["./.storybook/decorators/*"],
      "~stories/*": [
        "./packages/ag-grid-theme/stories/*",
        "./packages/core/stories/*",
        "./packages/countries/stories/*",
        "./packages/date-components/stories/*",
        "./packages/icons/stories/*",
        "./packages/lab/stories/*",
        "./packages/embla-carousel/stories/*",
        "./packages/theme/stories/*"
      ],
      "@salt-ds/date-adapters/*": [
        "./packages/date-adapters/src/*-adapter/index.ts"
      ]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages",
    "integration/toolkit",
    ".storybook/decorators",
    "docs",
    "tooling",
    "test/browser",
    "vitest.browser.config.mts",
    "./declarations.d.ts"
  ],
  "exclude": ["packages/mcp/eval-fixtures/**"]
}
