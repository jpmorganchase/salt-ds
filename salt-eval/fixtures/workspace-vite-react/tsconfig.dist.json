        "../../../packages/embla-carousel/dist-types/index.d.ts"
      ],
      "@salt-ds/icons": ["../../../packages/icons/dist-types/index.d.ts"],
      "@salt-ds/lab": ["../../../packages/lab/dist-types/index.d.ts"],
      "@salt-ds/styles": ["../../../packages/styles/dist-types/index.d.ts"],
