{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/salt-sample-app-cohort-receipt-2.json",
  "title": "Salt sample app current workflow receipt v2",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "contract",
    "source_commit",
    "apps",
    "knowledge_bundle",
    "packages",
    "install",
    "offline_guard",
    "checks"
  ],
  "properties": {
    "$schema": {
      "const": "https://www.saltdesignsystem.com/ai/schemas/salt-sample-app-cohort-receipt-2.json"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "contract": {
      "const": "salt-sample-app-cohort-receipt/2"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "manifest_sha256",
          "isolated_manifest_sha256"
        ],
        "properties": {
          "name": {
            "enum": ["vite-starter", "next-app-router", "operations-dashboard"]
          },
          "path": {
            "type": "string",
            "pattern": "^examples/apps/[a-z0-9-]+$"
          },
          "manifest_sha256": {
            "$ref": "#/$defs/digest"
          },
          "isolated_manifest_sha256": {
            "$ref": "#/$defs/digest"
          }
        },
        "additionalProperties": false
      }
    },
    "knowledge_bundle": {
      "type": "object",
      "required": [
        "version",
        "bundle_digest",
        "semantic_digest",
        "semantic_source_digest",
        "compiler_digest"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "bundle_digest": {
          "$ref": "#/$defs/digest"
        },
        "semantic_digest": {
          "$ref": "#/$defs/digest"
        },
        "semantic_source_digest": {
          "$ref": "#/$defs/digest"
        },
        "compiler_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "roles",
          "used_by",
          "source_manifest_sha256",
          "packed_manifest_sha256",
          "tarball"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^@salt-ds/[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["tooling", "direct", "transitive"]
            }
          },
          "used_by": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "vite-starter",
                "next-app-router",
                "operations-dashboard"
              ]
            }
          },
          "source_manifest_sha256": {
            "$ref": "#/$defs/digest"
          },
          "packed_manifest_sha256": {
            "$ref": "#/$defs/digest"
          },
          "tarball": {
            "type": "object",
            "required": ["path", "sha256", "integrity", "bytes", "files"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^dist/salt-sample-apps/[a-z0-9-]+\\.artifacts/[a-z0-9._-]+\\.tgz$"
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              },
              "integrity": {
                "type": "string",
                "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "files": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "install": {
      "type": "object",
      "required": [
        "package_manager",
        "lockfiles",
        "source_manifests_unchanged",
        "source_lockfiles_unchanged",
        "workspace_links",
        "first_party_registry_fallbacks",
        "physical_first_party_packages"
      ],
      "properties": {
        "package_manager": {
          "const": "npm"
        },
        "lockfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["app", "sha256", "replay"],
            "properties": {
              "app": {
                "enum": [
                  "vite-starter",
                  "next-app-router",
                  "operations-dashboard"
                ]
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              },
              "replay": {
                "const": "unchanged"
              }
            },
            "additionalProperties": false
          }
        },
        "source_manifests_unchanged": {
          "const": true
        },
        "source_lockfiles_unchanged": {
          "const": true
        },
        "workspace_links": {
          "const": 0
        },
        "first_party_registry_fallbacks": {
          "const": 0
        },
        "physical_first_party_packages": {
          "type": "integer",
          "minimum": 2
        }
      },
      "additionalProperties": false
    },
    "offline_guard": {
      "type": "object",
      "required": ["status", "phase", "allowed_hosts", "negative_fixture"],
      "properties": {
        "status": {
          "const": "pass"
        },
        "phase": {
          "const": "post-install"
        },
        "allowed_hosts": {
          "const": ["127.0.0.1", "::1", "localhost"]
        },
        "negative_fixture": {
          "type": "object",
          "required": ["target", "result"],
          "properties": {
            "target": {
              "const": "https://example.invalid/salt-sample-app-offline-guard"
            },
            "result": {
              "const": "blocked"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "app",
          "build",
          "typecheck",
          "interaction",
          "a11y",
          "keyboard",
          "runtime_errors",
          "external_requests",
          "commands",
          "analysis"
        ],
        "properties": {
          "app": {
            "enum": ["vite-starter", "next-app-router", "operations-dashboard"]
          },
          "build": {
            "const": "pass"
          },
          "typecheck": {
            "const": "pass"
          },
          "interaction": {
            "const": "pass"
          },
          "a11y": {
            "const": "pass"
          },
          "keyboard": {
            "const": "pass"
          },
          "server_render": {
            "const": "pass"
          },
          "hydration": {
            "const": "pass"
          },
          "runtime_errors": {
            "const": 0
          },
          "external_requests": {
            "const": 0
          },
          "commands": {
            "type": "object",
            "required": ["read_only", "info", "docs", "context"],
            "properties": {
              "read_only": {
                "const": true
              },
              "info": {
                "type": "object",
                "required": [
                  "result",
                  "contract",
                  "project_root",
                  "selection_status",
                  "coverage_status",
                  "compatible",
                  "observed_package_count",
                  "paths",
                  "bundle_digest",
                  "semantic_digest"
                ],
                "properties": {
                  "result": {
                    "const": "pass"
                  },
                  "contract": {
                    "const": "salt-cli-info/1"
                  },
                  "project_root": {
                    "const": "."
                  },
                  "selection_status": {
                    "const": "selected"
                  },
                  "coverage_status": {
                    "const": "complete"
                  },
                  "compatible": {
                    "const": true
                  },
                  "observed_package_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "paths": {
                    "const": "repository_relative"
                  },
                  "bundle_digest": {
                    "$ref": "#/$defs/digest"
                  },
                  "semantic_digest": {
                    "$ref": "#/$defs/digest"
                  }
                },
                "additionalProperties": false
              },
              "docs": {
                "type": "object",
                "required": [
                  "result",
                  "contract",
                  "status",
                  "record_key",
                  "bundle_digest"
                ],
                "properties": {
                  "result": {
                    "const": "pass"
                  },
                  "contract": {
                    "const": "salt-knowledge-document/1"
                  },
                  "status": {
                    "const": "resolved"
                  },
                  "record_key": {
                    "const": "record:component:component.button"
                  },
                  "bundle_digest": {
                    "$ref": "#/$defs/digest"
                  }
                },
                "additionalProperties": false
              },
              "context": {
                "type": "object",
                "required": [
                  "result",
                  "contract",
                  "match_count",
                  "context_digest",
                  "bytes",
                  "bundle_digest"
                ],
                "properties": {
                  "result": {
                    "const": "pass"
                  },
                  "contract": {
                    "const": "salt-knowledge-context/1"
                  },
                  "match_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "context_digest": {
                    "$ref": "#/$defs/digest"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "bundle_digest": {
                    "$ref": "#/$defs/digest"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "analysis": {
            "type": "object",
            "required": [
              "status",
              "availability",
              "reason_code",
              "clean_result"
            ],
            "properties": {
              "status": {
                "const": "not_run"
              },
              "availability": {
                "const": "unavailable"
              },
              "reason_code": {
                "const": "ANALYSIS_NOT_RUN"
              },
              "clean_result": {
                "const": false
              }
            },
            "additionalProperties": false
          },
          "workflow": {
            "type": "object",
            "required": [
              "contract",
              "status",
              "validation",
              "cancellation_retains_draft",
              "pending_duplicate_rejected",
              "failure_preserves_draft",
              "retry_succeeds",
              "focus",
              "labels_and_errors",
              "viewport_css_px",
              "zoom_claim",
              "screenshots",
              "validation_removed_variant"
            ],
            "properties": {
              "contract": {
                "const": "salt-sample-app-record-form-workflow/1"
              },
              "status": {
                "const": "pass"
              },
              "validation": {
                "const": "pass"
              },
              "cancellation_retains_draft": {
                "const": true
              },
              "pending_duplicate_rejected": {
                "const": true
              },
              "failure_preserves_draft": {
                "const": true
              },
              "retry_succeeds": {
                "const": true
              },
              "focus": {
                "const": "pass"
              },
              "labels_and_errors": {
                "const": "associated"
              },
              "viewport_css_px": {
                "const": 320
              },
              "zoom_claim": {
                "const": "not_tested"
              },
              "screenshots": {
                "const": [
                  "invalid.png",
                  "pending.png",
                  "failure.png",
                  "narrow-320-css-px.png"
                ]
              },
              "validation_removed_variant": {
                "const": "rejected"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "app": {
                  "const": "operations-dashboard"
                }
              },
              "required": ["app"]
            },
            "then": {
              "properties": {
                "workflow": {}
              },
              "required": ["workflow"]
            },
            "else": {
              "not": {
                "required": ["workflow"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "app": {
                  "const": "next-app-router"
                }
              },
              "required": ["app"]
            },
            "then": {
              "properties": {
                "server_render": {},
                "hydration": {}
              },
              "required": ["server_render", "hydration"]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "properties": {
                      "server_render": {}
                    },
                    "required": ["server_render"]
                  },
                  {
                    "properties": {
                      "hydration": {}
                    },
                    "required": ["hydration"]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "apps": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/vite-starter-name"
            }
          }
        },
        "required": ["apps"]
      },
      "then": {
        "properties": {
          "apps": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/vite-starter-name"
            },
            "minContains": 1,
            "maxContains": 1
          },
          "checks": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/vite-starter-check"
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "type": "array",
            "not": {
              "contains": {
                "$ref": "#/$defs/vite-starter-check"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "apps": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/next-app-router-name"
            }
          }
        },
        "required": ["apps"]
      },
      "then": {
        "properties": {
          "apps": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/next-app-router-name"
            },
            "minContains": 1,
            "maxContains": 1
          },
          "checks": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/next-app-router-check"
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "type": "array",
            "not": {
              "contains": {
                "$ref": "#/$defs/next-app-router-check"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "apps": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/operations-dashboard-name"
            }
          }
        },
        "required": ["apps"]
      },
      "then": {
        "properties": {
          "apps": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/operations-dashboard-name"
            },
            "minContains": 1,
            "maxContains": 1
          },
          "checks": {
            "type": "array",
            "contains": {
              "$ref": "#/$defs/operations-dashboard-check"
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "type": "array",
            "not": {
              "contains": {
                "$ref": "#/$defs/operations-dashboard-check"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "vite-starter-name": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "const": "vite-starter"
        }
      }
    },
    "next-app-router-name": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "const": "next-app-router"
        }
      }
    },
    "operations-dashboard-name": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "const": "operations-dashboard"
        }
      }
    },
    "vite-starter-check": {
      "type": "object",
      "required": ["app"],
      "properties": {
        "app": {
          "const": "vite-starter"
        }
      }
    },
    "next-app-router-check": {
      "type": "object",
      "required": ["app"],
      "properties": {
        "app": {
          "const": "next-app-router"
        }
      }
    },
    "operations-dashboard-check": {
      "type": "object",
      "required": ["app"],
      "properties": {
        "app": {
          "const": "operations-dashboard"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
