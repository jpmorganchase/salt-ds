{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/salt-ai-web-release-receipt-1.json",
  "title": "Salt AI web release receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract",
    "channel",
    "publishable",
    "bundle_version",
    "bundle_digest",
    "semantic_digest",
    "digest_segment",
    "knowledge_manifest",
    "distribution_projection_sha256",
    "public_docs_preview",
    "route_map",
    "pointers",
    "agent_support",
    "production_navigation",
    "deployment"
  ],
  "properties": {
    "$schema": { "const": "https://www.saltdesignsystem.com/ai/schemas/salt-ai-web-release-receipt-1.json" },
    "schema_version": { "const": "1.0.0" },
    "contract": { "const": "salt-ai-web-release-receipt/1" },
    "channel": { "const": "beta-candidate" },
    "publishable": { "const": false },
    "bundle_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "bundle_digest": { "$ref": "#/$defs/digest" },
    "semantic_digest": { "$ref": "#/$defs/digest" },
    "digest_segment": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "knowledge_manifest": { "$ref": "#/$defs/artifact" },
    "distribution_projection_sha256": { "$ref": "#/$defs/digest" },
    "public_docs_preview": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "bytes", "projection_sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/digest" },
            "bytes": { "type": "integer", "minimum": 1 },
            "projection_sha256": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "route_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "routes"],
      "properties": {
        "path": { "const": "dist/salt-ai-web/route-map.json" },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 },
        "routes": { "type": "integer", "minimum": 1 }
      }
    },
    "pointers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beta", "immutable", "current", "root"],
      "properties": {
        "beta": { "const": "/ai/beta/llms.txt" },
        "immutable": { "type": "string", "pattern": "^/ai/v1/[0-9a-f]{64}/llms\\.txt$" },
        "current": { "type": "null" },
        "root": { "type": "null" }
      }
    },
    "agent_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "agents_pointer"],
      "properties": {
        "skill": { "$ref": "#/$defs/agentArtifact" },
        "agents_pointer": { "$ref": "#/$defs/agentArtifact" }
      }
    },
    "production_navigation": { "const": false },
    "deployment": { "const": "not-performed" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "agentArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npm_path", "web_path", "sha256", "bytes"],
      "properties": {
        "npm_path": { "type": "string", "pattern": "^skills/salt-design-system/" },
        "web_path": { "type": "string", "pattern": "^/ai/v1/[0-9a-f]{64}/skills/salt-design-system/" },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
