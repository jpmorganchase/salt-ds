{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/salt-evidence-selector-1.json",
  "title": "Salt evidence selector v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selectors"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "plan_id", "unit_id", "kind", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "plan_id": { "type": "string", "pattern": "^[0-9]{3}$" },
          "unit_id": { "type": "string", "pattern": "^[0-9]{2}[a-z]?$" },
          "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
