{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/salt-authored-example-manifest-1.json",
  "title": "Salt authored example manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contract", "examples"],
  "properties": {
    "$schema": { "const": "https://www.saltdesignsystem.com/ai/schemas/salt-authored-example-manifest-1.json" },
    "schemaVersion": { "const": "1.0.0" },
    "contract": { "const": "salt-authored-example-manifest/1" },
    "examples": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "exportName",
          "route",
          "entry",
          "visibility",
          "stability",
          "provenance",
          "sourceAuthority",
          "files",
          "externalDependencies",
          "saltPackages"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "exportName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "route": { "type": "string", "pattern": "^/salt/patterns/[a-z0-9-]+$" },
          "entry": { "$ref": "#/$defs/path" },
          "visibility": { "const": "public" },
          "stability": { "enum": ["experimental", "stable", "deprecated"] },
          "provenance": { "const": "authored_example" },
          "sourceAuthority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["implementation", "guidance", "maintainerFacade"],
            "properties": {
              "implementation": { "$ref": "#/$defs/path" },
              "guidance": { "$ref": "#/$defs/path" },
              "maintainerFacade": { "$ref": "#/$defs/path" }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/path" }
          },
          "externalDependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "saltPackages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^@salt-ds/" }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
