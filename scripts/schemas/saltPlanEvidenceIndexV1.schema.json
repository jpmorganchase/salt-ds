{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/salt-plan-evidence-index-1.json",
  "title": "Salt plan evidence index v1",
  "type": "object",
  "required": ["schema_version", "plan_id", "unit_id", "tracker_status", "completion_sha", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "plan_id": { "type": "string", "pattern": "^[0-9]{3}$" },
    "unit_id": { "type": "string", "pattern": "^[0-9]{2}[a-z]?$" },
    "tracker_status": { "type": "string" },
    "completion_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "schema_id", "schema_version", "locator", "sha256", "source_sha", "completion_sha", "workflow_class", "environment_class", "retention_expires_at", "parents", "state"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "schema_id": { "type": "string", "minLength": 1 },
          "schema_version": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "pattern": "^(repo|https)://.*sha256-[0-9a-f]{64}" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "source_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
          "completion_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
          "workflow_class": { "type": "string" },
          "environment_class": { "type": "string" },
          "retention_expires_at": { "type": "string", "format": "date-time" },
          "parents": { "type": "array", "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "uniqueItems": true },
          "state": { "enum": ["active", "superseded", "retired"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
