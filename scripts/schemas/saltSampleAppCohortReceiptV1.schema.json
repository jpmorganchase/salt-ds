{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/salt-sample-app-cohort-receipt-1.json",
  "title": "Salt sample app candidate cohort receipt v1",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "contract",
    "source_commit",
    "apps",
    "knowledge_bundle",
    "packages",
    "install",
    "offline_guard",
    "checks"
  ],
  "properties": {
    "$schema": {
      "const": "https://www.saltdesignsystem.com/ai/schemas/salt-sample-app-cohort-receipt-1.json"
    },
    "schema_version": { "const": "1.0.0" },
    "contract": { "const": "salt-sample-app-cohort-receipt/1" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "apps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "manifest_sha256",
          "isolated_manifest_sha256"
        ],
        "properties": {
          "name": {
            "enum": ["vite-starter", "next-app-router", "operations-dashboard"]
          },
          "path": { "type": "string", "pattern": "^examples/apps/[a-z0-9-]+$" },
          "manifest_sha256": { "$ref": "#/$defs/digest" },
          "isolated_manifest_sha256": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "knowledge_bundle": {
      "type": "object",
      "required": [
        "version",
        "bundle_digest",
        "semantic_digest",
        "semantic_source_digest",
        "compiler_digest"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "bundle_digest": { "$ref": "#/$defs/digest" },
        "semantic_digest": { "$ref": "#/$defs/digest" },
        "semantic_source_digest": { "$ref": "#/$defs/digest" },
        "compiler_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "roles",
          "used_by",
          "source_manifest_sha256",
          "packed_manifest_sha256",
          "tarball"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^@salt-ds/[a-z0-9-]+$" },
          "version": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["tooling", "direct", "transitive"] }
          },
          "used_by": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "vite-starter",
                "next-app-router",
                "operations-dashboard"
              ]
            }
          },
          "source_manifest_sha256": { "$ref": "#/$defs/digest" },
          "packed_manifest_sha256": { "$ref": "#/$defs/digest" },
          "tarball": {
            "type": "object",
            "required": ["path", "sha256", "integrity", "bytes", "files"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^dist/salt-sample-apps/[a-z0-9-]+\\.artifacts/[a-z0-9._-]+\\.tgz$"
              },
              "sha256": { "$ref": "#/$defs/digest" },
              "integrity": {
                "type": "string",
                "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
              },
              "bytes": { "type": "integer", "minimum": 1 },
              "files": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "install": {
      "type": "object",
      "required": [
        "package_manager",
        "lockfiles",
        "source_manifests_unchanged",
        "source_lockfiles_unchanged",
        "workspace_links",
        "first_party_registry_fallbacks",
        "physical_first_party_packages"
      ],
      "properties": {
        "package_manager": { "const": "npm" },
        "lockfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["app", "sha256", "replay"],
            "properties": {
              "app": {
                "enum": [
                  "vite-starter",
                  "next-app-router",
                  "operations-dashboard"
                ]
              },
              "sha256": { "$ref": "#/$defs/digest" },
              "replay": { "const": "unchanged" }
            },
            "additionalProperties": false
          }
        },
        "source_manifests_unchanged": { "const": true },
        "source_lockfiles_unchanged": { "const": true },
        "workspace_links": { "const": 0 },
        "first_party_registry_fallbacks": { "const": 0 },
        "physical_first_party_packages": { "type": "integer", "minimum": 2 }
      },
      "additionalProperties": false
    },
    "offline_guard": {
      "type": "object",
      "required": ["status", "phase", "allowed_hosts", "negative_fixture"],
      "properties": {
        "status": { "const": "pass" },
        "phase": { "const": "post-install" },
        "allowed_hosts": {
          "const": ["127.0.0.1", "::1", "localhost"]
        },
        "negative_fixture": {
          "type": "object",
          "required": ["target", "result"],
          "properties": {
            "target": {
              "const": "https://example.invalid/salt-sample-app-offline-guard"
            },
            "result": { "const": "blocked" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "app",
          "build",
          "typecheck",
          "interaction",
          "a11y",
          "keyboard",
          "scan"
        ],
        "properties": {
          "app": {
            "enum": ["vite-starter", "next-app-router", "operations-dashboard"]
          },
          "build": { "const": "pass" },
          "typecheck": { "const": "pass" },
          "interaction": { "const": "pass" },
          "a11y": { "const": "pass" },
          "keyboard": { "const": "pass" },
          "scan": {
            "type": "object",
            "required": [
              "result",
              "coverage",
              "allow_incomplete",
              "reasons",
              "errors",
              "warnings",
              "findings"
            ],
            "properties": {
              "result": { "const": "pass" },
              "coverage": { "enum": ["complete", "partial"] },
              "allow_incomplete": { "const": true },
              "reasons": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "errors": { "const": 0 },
              "warnings": { "const": 0 },
              "findings": { "const": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
