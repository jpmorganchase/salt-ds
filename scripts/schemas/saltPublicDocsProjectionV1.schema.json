{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/salt-public-docs-projection-1.json",
  "title": "Salt public docs projection receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract",
    "mode",
    "source_commit",
    "source_root",
    "source_manifest",
    "bundle_version",
    "projection_sha256",
    "documents",
    "navigation_activation_targets",
    "navigation_status",
    "production_navigation",
    "nonproduction_marker",
    "mcp"
  ],
  "properties": {
    "$schema": { "const": "https://www.saltdesignsystem.com/ai/schemas/salt-public-docs-projection-1.json" },
    "schema_version": { "const": "1.0.0" },
    "contract": { "const": "salt-public-docs-projection/1" },
    "mode": { "enum": ["preview", "final", "rebind-landed"] },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_root": { "const": "tooling/ai/public-docs-v1" },
    "source_manifest": { "$ref": "#/$defs/artifact" },
    "bundle_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "projection_sha256": { "$ref": "#/$defs/digest" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "route", "markdown_route", "title", "summary", "media_type", "sha256", "bytes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "source": { "type": "string", "pattern": "^tooling/ai/public-docs-v1/" },
          "route": { "type": "string", "pattern": "^/ai/.*/$" },
          "markdown_route": { "type": "string", "pattern": "^/ai/.*/index\\.md$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "media_type": { "const": "text/markdown; charset=utf-8" },
          "sha256": { "$ref": "#/$defs/digest" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "navigation_activation_targets": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "navigation_status": { "const": "staged" },
    "production_navigation": { "const": false },
    "nonproduction_marker": { "const": "Salt AI nonproduction preview" },
    "mcp": { "const": "excluded-until-final-disposition" },
    "finalized_from": { "$ref": "#/$defs/artifact" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
