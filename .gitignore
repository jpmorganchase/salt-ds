# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Identify the release and plugin bundles as binary content.
# This way Git won't bother showing massive diffs when each time you subsequently add or update them
/.yarn/releases/** binary
/.yarn/plugins/** binary

# testing
/.vitest
/test/browser/screenshots
/coverage
.nyc_output

# production
/packages/*/build
/packages/*/dist-cjs/
/packages/*/dist-es/
/packages/*/dist-types/
/packages/ag-grid-theme/fonts/
/packages/ag-grid-theme/salt-ag-theme.css
/packages/core/css/
/packages/countries/css/
/packages/date-components/css/
/packages/embla-carousel/css/
/packages/icons/css/
/packages/lab/css/
/packages/react-resizable-panels-theme/index.css
/packages/theme/css/
/packages/theme/index.css

dist
storybook-static

# misc
.DS_Store
.eslintcache

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.idea
.vscode
/.VSCodeCounter
*.iml

# Autogenerated CSS
/docs/css/salt-core.css
/docs/css/salt-lab.css
/docs/css/salt-countries.css
/docs/css/salt-embla-carousel.css
/docs/css/salt-date-components.css
