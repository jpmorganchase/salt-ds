{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/evals/mcp-candidate-run-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "cohort_id",
    "candidate_source_sha",
    "candidate",
    "knowledge",
    "protocol",
    "frozen_subset",
    "host_matrix",
    "outcomes",
    "costs",
    "security_interoperability",
    "recommendation",
    "rationale",
    "sanitization"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract": { "const": "salt-mcp-candidate-evaluation-run/1" },
    "cohort_id": { "const": "mcp-pre-release" },
    "candidate_source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_report", "package"],
      "properties": {
        "pack_report": { "$ref": "#/$defs/artifact" },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "tarball"],
          "properties": {
            "name": { "const": "@salt-ds/mcp" },
            "version": { "const": "0.0.0" },
            "tarball": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_version",
        "bundle_digest",
        "semantic_digest",
        "semantic_source_digest",
        "compiler_digest",
        "manifest"
      ],
      "properties": {
        "package_version": { "const": "0.0.0" },
        "bundle_digest": { "$ref": "#/$defs/digest" },
        "semantic_digest": { "$ref": "#/$defs/digest" },
        "semantic_source_digest": { "$ref": "#/$defs/digest" },
        "compiler_digest": { "$ref": "#/$defs/digest" },
        "manifest": { "$ref": "#/$defs/artifact" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version",
        "server_sdk_version",
        "client_sdk_version"
      ],
      "properties": {
        "spec_version": { "const": "2026-07-28" },
        "server_sdk_version": { "const": "2.0.0" },
        "client_sdk_version": { "const": "2.0.0" }
      }
    },
    "frozen_subset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "task_ids",
        "repetitions",
        "host_model_aliases"
      ],
      "properties": {
        "manifest": { "$ref": "#/$defs/artifact" },
        "task_ids": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "repetitions": { "const": 3 },
        "host_model_aliases": {
          "const": ["host_model_a", "host_model_b"]
        }
      }
    },
    "host_matrix": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/host" }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode_3", "mode_4", "paired"],
      "properties": {
        "mode_3": { "$ref": "#/$defs/outcome" },
        "mode_4": { "$ref": "#/$defs/outcome" },
        "paired": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "percentage_point_delta",
            "additional_successful_cells_by_host_model",
            "version_correctness_regression",
            "unsupported_claim_rate_regression",
            "threshold_passed"
          ],
          "properties": {
            "percentage_point_delta": {
              "type": ["number", "null"]
            },
            "additional_successful_cells_by_host_model": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["host_model_alias", "count"],
                "properties": {
                  "host_model_alias": {
                    "enum": ["host_model_a", "host_model_b"]
                  },
                  "count": { "type": "integer" }
                }
              }
            },
            "version_correctness_regression": {
              "enum": [false, true, "not_measured"]
            },
            "unsupported_claim_rate_regression": {
              "enum": [false, true, "not_measured"]
            },
            "threshold_passed": { "type": "boolean" }
          }
        }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_measurement",
        "runtime_loc_measurement",
        "setup",
        "observed_model_usage",
        "per_cell_ceiling"
      ],
      "properties": {
        "surface_measurement": { "$ref": "#/$defs/artifact" },
        "runtime_loc_measurement": { "$ref": "#/$defs/artifact" },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode_3_bootstrap_artifacts",
            "mode_4_additional_packages",
            "mode_4_tools",
            "mode_4_tool_list_utf8_bytes",
            "mode_4_cold_load_ms",
            "mode_4_warm_load_ms"
          ],
          "properties": {
            "mode_3_bootstrap_artifacts": { "const": 2 },
            "mode_4_additional_packages": { "const": 1 },
            "mode_4_tools": { "const": 3 },
            "mode_4_tool_list_utf8_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24000
            },
            "mode_4_cold_load_ms": { "type": "number", "minimum": 0 },
            "mode_4_warm_load_ms": { "type": "number", "minimum": 0 }
          }
        },
        "observed_model_usage": { "$ref": "#/$defs/usage" },
        "per_cell_ceiling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "turns",
            "tool_calls",
            "wall_time_seconds"
          ],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 1 },
            "output_tokens": { "type": "integer", "minimum": 1 },
            "turns": { "type": "integer", "minimum": 1 },
            "tool_calls": { "type": "integer", "minimum": 1 },
            "wall_time_seconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "security_interoperability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_smoke",
        "exact_pack_identity",
        "bundle_integrity",
        "offline",
        "current_spec",
        "legacy_rejected",
        "path_isolation",
        "commonjs_esm_parity",
        "all_gates_passed"
      ],
      "properties": {
        "consumer_smoke": { "$ref": "#/$defs/artifact" },
        "exact_pack_identity": { "const": true },
        "bundle_integrity": { "const": true },
        "offline": { "const": true },
        "current_spec": { "const": true },
        "legacy_rejected": { "const": true },
        "path_isolation": { "const": true },
        "commonjs_esm_parity": { "const": true },
        "all_gates_passed": { "const": true }
      }
    },
    "recommendation": { "enum": ["ship", "omit"] },
    "rationale": { "type": "string", "minLength": 40 },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_prompts",
        "raw_model_outputs",
        "credentials",
        "proprietary_fixtures",
        "absolute_paths"
      ],
      "properties": {
        "raw_prompts": { "const": false },
        "raw_model_outputs": { "const": false },
        "credentials": { "const": false },
        "proprietary_fixtures": { "const": false },
        "absolute_paths": { "const": false }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_model_alias",
        "scheduled_cells_per_mode",
        "completed_mode_3_cells",
        "completed_mode_4_cells",
        "status",
        "reason"
      ],
      "properties": {
        "host_model_alias": {
          "enum": ["host_model_a", "host_model_b"]
        },
        "scheduled_cells_per_mode": { "const": 36 },
        "completed_mode_3_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "completed_mode_4_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "status": { "enum": ["complete", "not_run", "failed"] },
        "reason": { "type": "string", "minLength": 10 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduled_cells",
        "completed_cells",
        "successful_cells"
      ],
      "properties": {
        "scheduled_cells": { "const": 72 },
        "completed_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 72
        },
        "successful_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 72
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_cells",
        "input_tokens",
        "output_tokens",
        "tool_calls",
        "wall_time_ms",
        "estimated_cost_usd"
      ],
      "properties": {
        "model_cells": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "number", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
