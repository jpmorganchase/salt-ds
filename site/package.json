{
  "name": "@salt-ds/site",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "description": "@salt-ds/site Site generated by Mosaic generator",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "scripts": {
    "clean": "rm -fr public/.tmp .next",
    "build": "yarn gen:icons && yarn gen:css && next build",
    "dev": "yarn gen:css && next dev",
    "start": "next start",
    "gen:snapshot": "yarn gen:props && yarn mosaic build --out snapshots --name latest --config mosaic.config.mjs && node scripts/verify-mosaic-snapshot.mjs",
    "serve:snapshot:file": "yarn cross-env MOSAIC_MODE='snapshot-file' concurrently --kill-others 'yarn dev'",
    "serve:mosaic": "yarn cross-env NODE_ENV=development mosaic serve -c ./mosaic.config.mjs -p 8080",
    "serve": "concurrently --kill-others \"yarn dev\" \"yarn serve:mosaic\"",
    "gen:props": "yarn node './propsGen.js'",
    "gen:icons": "yarn workspace @salt-ds/icons clean && yarn workspace @salt-ds/icons build:icons",
    "gen:css": "yarn node './cssGen.mjs'",
    "spellcheck": "yarn cspell --config cspell.jsonc \"docs/**/*.mdx\" \"src/examples/**/*.tsx\"",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@jpmorganchase/mosaic-cli": "1.0.0-beta.99",
    "@jpmorganchase/mosaic-layouts": "1.0.0-beta.99",
    "@jpmorganchase/mosaic-plugins": "1.0.0-beta.99",
    "@jpmorganchase/mosaic-schemas": "1.0.0-beta.99",
    "@jpmorganchase/mosaic-site-middleware": "1.0.0-beta.99",
    "@jpmorganchase/mosaic-source-git-repo": "1.0.0-beta.99",
    "@jpmorganchase/mosaic-source-http": "1.0.0-beta.99",
    "@jpmorganchase/mosaic-source-local-folder": "1.0.0-beta.99",
    "@jpmorganchase/mosaic-store": "1.0.0-beta.99",
    "css-tree": "^3.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "decimal.js": "^10.4.3",
    "embla-carousel-react": "^8.6.0",
    "lodash-es": "^4.17.21",
    "luxon": "^3.7.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.1",
    "next": "^16.4.2",
    "next-mdx-remote-client": "^2.1.12",
    "shiki": "^4.0.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@next/env": "^16.4.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "cspell": "^10.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.0.0",
    "typescript": "^6.0.0"
  }
}
