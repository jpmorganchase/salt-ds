  "description": "Themes, design tokens and global CSS for Salt Design System.",
  "homepage": "https://www.saltdesignsystem.com/salt/themes",
  "keywords": [
    "salt-design-system",
    "css",
    "theme",
    "design-tokens"
  ],
  "license": "Apache-2.0",
  "repository": {
