{
  "name": "@salt-ds/icons",
  "version": "1.18.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpmorganchase/salt-ds.git",
    "directory": "packages/icons"
  },
  "bugs": "https://github.com/jpmorganchase/salt-ds/issues",
  "forbiddenDependencies": [
    "@salt-ds/icons",
    "@salt-ds/core",
    "@salt-ds/lab"
  ],
  "main": "src/index.ts",
  "typings": "dist-types/index.d.ts",
  "files": [
    "css",
    "saltIcons.css",
    "dist-cjs",
    "dist-es",
    "dist-types"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "yarn clean && yarn build:icons && yarn node ../../scripts/build.mjs",
    "build:icons": "yarn node ./scripts/generateIcons.mjs '*.svg'",
    "copy:css": "yarn node ./scripts/copyCss.mjs",
    "clean": "rimraf ./src/components",
    "generate:icons": "yarn node ./scripts/artwork/generate.mjs && yarn build:icons",
    "validate:icons": "yarn node ./scripts/artwork/validate.mjs && yarn node ./scripts/artwork/check-new-icon-reviews.mjs",
    "audit:icons": "yarn node ./scripts/artwork/audit-junctions.mjs",
    "check:icon-reviews": "yarn node ./scripts/artwork/audit-junctions.mjs --complete",
    "test:artwork": "yarn node --test ./scripts/artwork/junction-trace.test.mjs ./scripts/artwork/junction-discovery.test.mjs ./scripts/artwork/junction-paint.test.mjs ./scripts/artwork/junction-review-state.test.mjs ./scripts/artwork/junction-review-page.test.mjs ./scripts/artwork/contour-profiles.test.mjs ./scripts/artwork/path-segments.test.mjs ./scripts/artwork/painted-corners.test.mjs ./scripts/artwork/corner-review-state.test.mjs ./scripts/artwork/pixel-grid.test.mjs ./scripts/artwork/pair-contours.test.mjs",
    "audit:corners": "yarn node ./scripts/artwork/audit-corners.mjs",
    "check:corner-reviews": "yarn node ./scripts/artwork/audit-corners.mjs --complete",
    "audit:pixel-grid": "yarn node ./scripts/artwork/audit-pixel-grid.mjs",
    "audit:pairs": "yarn node ./scripts/artwork/audit-pairs.mjs",
    "check:pair-reviews": "yarn node ./scripts/artwork/audit-pairs.mjs --complete",
    "compare:glyph-sizes": "yarn node ./scripts/artwork/compare-glyph-sizes.mjs"
  },
  "dependencies": {
    "@salt-ds/styles": "workspace:*",
    "@salt-ds/window": "workspace:*",
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@types/react": ">=16.14.0",
    "react": ">=16.14.0",
    "react-dom": ">=16.14.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "glob": "^13.0.0",
    "mustache": "^4.2.0",
    "rimraf": "^6.0.0",
    "svgo": "^4.0.0"
  },
  "publishConfig": {
    "main": "dist-cjs/index.js",
    "module": "dist-es/index.js",
    "provenance": true
  }
}
