{
  "name": "@salt-ds/mcp",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpmorganchase/salt-ds.git",
    "directory": "packages/mcp"
  },
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "bin"
  ],
  "publishBinEntrypoints": {
    "bin/salt-mcp.js": {
      "requirePath": "../dist-cjs/cli.js",
      "exportName": "runSaltMcpCli",
      "errorPrefix": "salt-mcp error:",
      "conciseErrorCodes": [
        "SALT_MCP_CLI_USAGE"
      ]
    }
  },
  "publishExports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist-es/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishAdditionalEntryPaths": [
    "src/cli.ts"
  ],
  "typescriptInclude": [
    "src/index.ts"
  ],
  "typescriptRootDir": "src",
  "publishTypingEntryOnly": true,
  "publishPreserveModules": false,
  "publishScriptExcludes": [
    "build",
    "build:package",
    "measure:runtime-loc",
    "measure:surface",
    "prepack"
  ],
  "publishSourceMaps": false,
  "publishIncludeReadme": false,
  "publishIncludeChangelog": false,
  "bin": {
    "salt-mcp": "bin/salt-mcp.js"
  },
  "scripts": {
    "build:package": "yarn node ../../scripts/build.mjs",
    "build": "yarn build:package",
    "measure:surface": "node --expose-gc ./scripts/measurePublicSurface.mjs",
    "measure:runtime-loc": "node ./scripts/measureRuntimeReachableLoc.mjs",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@salt-ds/knowledge": "workspace:*",
    "@types/node": "^24.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "ajv": "^8.17.1",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "directory": "../../dist/salt-ds-mcp",
    "provenance": true
  }
}
