{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/item-applicability-1.json",
  "title": "Salt item applicability v1",
  "type": "object",
  "required": [
    "contract",
    "schema_version",
    "frozen_families",
    "profiles",
    "items"
  ],
  "properties": {
    "contract": { "const": "salt-item-applicability/1" },
    "schema_version": { "const": "1.0.0" },
    "frozen_families": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^@salt-ds/" }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "mode": { "$ref": "#/$defs/mode" },
          "packages": { "$ref": "#/$defs/packages" },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "source_items": { "$ref": "#/$defs/sourceItems" }
        },
        "oneOf": [
          {
            "required": ["profile"],
            "not": { "required": ["mode"] }
          },
          {
            "required": ["mode"],
            "not": { "required": ["profile"] }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "mode": {
      "enum": [
        "package-ranges",
        "version-independent",
        "unknown",
        "inherits"
      ]
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "range", "evidence"],
        "properties": {
          "name": { "type": "string", "pattern": "^@salt-ds/" },
          "range": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "sourceItems": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "profile": {
      "type": "object",
      "required": ["id", "mode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "packages": { "$ref": "#/$defs/packages" },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "source_items": { "$ref": "#/$defs/sourceItems" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
