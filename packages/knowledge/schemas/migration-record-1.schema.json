{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/migration-record-1.json",
  "title": "Salt migration record v1",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "owner",
    "status",
    "affected_packages",
    "prerequisites",
    "classification",
    "verification",
    "limitations"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planned", "active", "retired"] },
    "affected_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "from", "to"],
        "properties": {
          "name": { "type": "string", "pattern": "^@salt-ds/" },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "classification": {
      "enum": ["manual", "advisory-automatable", "codemod-available"]
    },
    "verification": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
