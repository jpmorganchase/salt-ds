{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.saltdesignsystem.com/ai/schemas/artifact-tree-node-1.json",
  "title": "Salt artifact tree node v1",
  "oneOf": [
    {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["kind", "artifacts"],
          "properties": {
            "kind": { "const": "leaf" },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "$ref": "#/$defs/artifact" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["kind", "children"],
          "properties": {
            "kind": { "const": "internal" },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "$ref": "#/$defs/reference" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["contract", "schema_version", "prefix"],
      "properties": {
        "contract": { "const": "salt-artifact-tree-node/1" },
        "schema_version": { "const": "1.0.0" },
        "prefix": { "type": "string" }
      }
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*%)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reference": {
      "type": "object",
      "required": ["file", "prefix", "bytes", "sha256"],
      "properties": {
        "file": { "$ref": "#/$defs/path" },
        "prefix": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "media_type", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "media_type": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
