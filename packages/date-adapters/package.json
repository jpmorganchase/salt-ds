{
  "name": "@salt-ds/date-adapters",
  "version": "1.0.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpmorganchase/salt-ds.git",
    "directory": "packages/date-adapters"
  },
  "bugs": "https://github.com/jpmorganchase/salt-ds/issues",
  "main": "src/index.ts",
  "saltSourceEntrypoints": {
    ".": "src/types/index.ts",
    "./date-fns": "src/date-fns-adapter/index.ts",
    "./date-fns-tz": "src/date-fns-tz-adapter/index.ts",
    "./dayjs": "src/dayjs-adapter/index.ts",
    "./luxon": "src/luxon-adapter/index.ts",
    "./moment": "src/moment-adapter/index.ts"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@date-fns/tz": "^1.4.1",
    "@types/luxon": "^3.7.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "luxon": "^3.7.2",
    "moment-timezone": "^0.6.1"
  },
  "peerDependenciesMeta": {
    "@date-fns/tz": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "luxon": {
      "optional": true
    },
    "@types/luxon": {
      "optional": true
    },
    "moment-timezone": {
      "optional": true
    }
  },
  "publishConfig": {
    "directory": "../../dist/salt-ds-date-adapters",
    "provenance": true
  },
  "scripts": {
    "build": "yarn node ./scripts/build.mjs"
  }
}
