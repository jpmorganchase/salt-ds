{
  "compilerOptions": {
    "declaration": false,
    "outDir": "./dist",
    "module": "ESNext",
    "target": "es2016",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@salt-ds/date-adapters": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/__tests__/*"]
}
